#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @VER_NUM@
 PRODUCTVERSION  @VER_NUM@
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "@VENDOR@\0"
      VALUE "FileDescription",  "@NAME@\0"
      VALUE "FileVersion",      "@VER_STR@\0"
      VALUE "InternalName",     "@NAME@\0"
      VALUE "OriginalFilename", "@FILE@\0"
      VALUE "ProductName",      "@NAME@\0"
      VALUE "ProductVersion",   "@VER_STR@\0"
      VALUE "Comments",         "@COMMENT@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
