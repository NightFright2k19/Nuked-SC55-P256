+		static std::mutex mutex;
+		static std::map<uint64_t, std::weak_ptr<const std::vector<uint8_t>>> cache;
+		uint64_t h = 1469598103934665603ull ^ (_rom0.size() * 31 + _rom1.size());
+		for (const auto* r : {&_rom0, &_rom1})
