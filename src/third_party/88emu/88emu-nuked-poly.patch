+	{
+		if(m_sc88Pro)
+		{
+			for(size_t i = 0; i < _size; ++i) _dst[i] = m_sc88Pro->peekWorkRam(_address + static_cast<uint32_t>(i));
+			return true;
+		}
+		if(m_sc88)
