+int emu88_get_active_voice_count(emu88_context context)
+{
+	if (!context || !context->device) return -1;
+	return context->device->activeVoiceCount();
+}
+
+
+emu88_return_code emu88_set_sc88pro_rom_images(const uint8_t* control, size_t controlSize,
+	const uint8_t* waveA, size_t waveASize, const uint8_t* waveB, size_t waveBSize,
+	const uint8_t* waveC, size_t waveCSize)
+{
+	// Only pointers are kept (the data must stay valid, e.g. linked into the binary).
+	emu88Lib::RomLoader::Sc88ProRomImages im;
+	im.firmware = control; im.firmwareSize = controlSize;
+	im.waveA = waveA; im.waveASize = waveASize;
+	im.waveB = waveB; im.waveBSize = waveBSize;
+	im.waveC = waveC; im.waveCSize = waveCSize;
+	emu88Lib::RomLoader::setInjectedSc88ProRomImages(&im);
+	if (!emu88Lib::RomLoader::findSc88ProRomSet(emu88Lib::RomDevice::Sc88Pro).isValid())
+	{
+		emu88Lib::RomLoader::setInjectedSc88ProRomImages(nullptr);
+		return EMU88_RC_INVALID_ARGUMENT;
+	}
+	return EMU88_RC_OK;
+}
+
+emu88_return_code emu88_dump_sc88pro_rom_images(const char* controlPath, const char* waveAPath,
+	const char* waveBPath, const char* waveCPath)
+{
+	const auto set = emu88Lib::RomLoader::findSc88ProRomSet(emu88Lib::RomDevice::Sc88Pro);
+	if (!set.isValid())
+		return EMU88_RC_MISSING_ROMS;
+	const auto write = [](const char* path, const std::vector<uint8_t>& data) {
+		FILE* f = std::fopen(path, "wb");
+		if (!f) return false;
+		const bool ok = std::fwrite(data.data(), 1, data.size(), f) == data.size();
+		std::fclose(f);
+		return ok;
+	};
+	if (!write(controlPath, set.firmware) || !write(waveAPath, set.waveA) || !write(waveBPath, set.waveB) ||
+	    !write(waveCPath, set.waveC))
+		return EMU88_RC_FAILED;
+	return EMU88_RC_OK;
+}
+
+int emu88_get_display_memory(emu88_context context, unsigned screen, uint8_t* ddRam80, uint8_t* cgRam64,
+	int* displayOn)
+{
+	if (!context || !context->device || screen > 1)
+		return 0;
+	const auto snap = context->device->displaySnapshot();
+	const auto& s = snap.screens[screen];
+	if (s.type != emu88Lib::HardwareDevice::DisplaySnapshot::Type::Character)
+		return 0;
+	if (ddRam80) std::memcpy(ddRam80, s.ddRam.data(), 80);
+	if (cgRam64) std::memcpy(cgRam64, s.cgRam.data(), 64);
+	if (displayOn) *displayOn = s.displayOn ? 1 : 0;
+	return 1;
+}
+
+emu88_return_code emu88_set_sc8850_rom_images(const uint8_t* cpu, size_t cpuSize, const uint8_t* program,
+	size_t programSize, const uint8_t* data, size_t dataSize, const uint8_t* wave, size_t waveSize)
+{
+	emu88Lib::RomLoader::Sc8850RomImages im;
+	im.cpu = cpu; im.cpuSize = cpuSize;
+	im.program = program; im.programSize = programSize;
+	im.data = data; im.dataSize = dataSize;
+	im.wave = wave; im.waveSize = waveSize;
+	if (!cpu || !program || !data || !wave || cpuSize != emu88Lib::Sc8850RomSet::CpuSize ||
+	    programSize != emu88Lib::Sc8850RomSet::ProgramSize || dataSize != emu88Lib::Sc8850RomSet::DataSize ||
+	    waveSize != emu88Lib::Sc8850WaveRomSet::Size)
+		return EMU88_RC_INVALID_ARGUMENT;
+	emu88Lib::RomLoader::setInjectedSc8850RomImages(&im);
+	return EMU88_RC_OK;
+}
+
+emu88_return_code emu88_dump_sc8850_rom_images(const char* cpuPath, const char* programPath, const char* dataPath,
+	const char* wavePath)
+{
+	const auto set = emu88Lib::RomLoader::findSc8850RomSet();
+	const auto waves = emu88Lib::RomLoader::findSc8850WaveRomSet();
+	if (!set.isValid() || !waves.isValid())
+		return EMU88_RC_MISSING_ROMS;
+	const auto write = [](const char* path, const std::vector<uint8_t>& a, const std::vector<uint8_t>* b) {
+		FILE* f = std::fopen(path, "wb");
+		if (!f) return false;
+		bool ok = std::fwrite(a.data(), 1, a.size(), f) == a.size();
+		if (b) ok = ok && std::fwrite(b->data(), 1, b->size(), f) == b->size();
+		std::fclose(f);
+		return ok;
+	};
+	if (!write(cpuPath, set.cpu, nullptr) || !write(programPath, set.program, nullptr) ||
+	    !write(dataPath, set.data, nullptr) || !write(wavePath, waves.romA, &waves.romB))
+		return EMU88_RC_FAILED;
+	return EMU88_RC_OK;
+}
+
+int emu88_get_display_pixels(emu88_context context, unsigned screen, uint8_t* dots, size_t size, int* width,
+	int* height, int* displayOn)
+{
+	if (!context || !context->device || screen > 1)
+		return 0;
+	const auto snap = context->device->displaySnapshot();
+	const auto& s = snap.screens[screen];
+	if (s.type != emu88Lib::HardwareDevice::DisplaySnapshot::Type::Graphic)
+		return 0;
+	if (width) *width = s.width;
+	if (height) *height = s.height;
+	if (displayOn) *displayOn = s.displayOn ? 1 : 0;
+	if (dots) std::memcpy(dots, s.mono.data(), std::min(size, s.mono.size()));
+	return 1;
+}
+
+void emu88_capture_midi_out(emu88_context context, int enable)
+{
+	if (!context) return;
+	context->captureOut = enable != 0;
+	context->outBytes.clear();
+}
+
+size_t emu88_read_midi_out(emu88_context context, uint8_t* buffer, size_t size)
+{
+	if (!context || !buffer) return 0;
+	const size_t n = std::min(size, context->outBytes.size());
+	std::memcpy(buffer, context->outBytes.data(), n);
+	context->outBytes.erase(context->outBytes.begin(), context->outBytes.begin() + static_cast<std::ptrdiff_t>(n));
+	return n;
+}
+
+int emu88_peek_work_ram(emu88_context context, uint32_t address, uint8_t* buffer, size_t size)
+{
+	if (!context || !context->device || !buffer) return 0;
+	return context->device->peekWorkRam(address, buffer, size) ? 1 : 0;
+}
+
+emu88_return_code emu88_set_sc88_rom_images(const uint8_t* control, size_t controlSize, const uint8_t* wave0,
+	size_t wave0Size, const uint8_t* wave1, size_t wave1Size, const uint8_t* wave2, size_t wave2Size,
+	const uint8_t* wave3, size_t wave3Size)
+{
+	const uint8_t* waves[4] = {wave0, wave1, wave2, wave3};
+	const size_t sizes[4]   = {wave0Size, wave1Size, wave2Size, wave3Size};
+	if (!control || controlSize != emu88Lib::Rom::Size)
+		return EMU88_RC_INVALID_ARGUMENT;
+	std::array<std::vector<uint8_t>, emu88Lib::WaveRom::ChipCount> chips;
+	for (size_t i = 0; i < chips.size(); ++i)
+	{
+		if (!waves[i] || sizes[i] != emu88Lib::WaveRom::ChipSize)
+			return EMU88_RC_INVALID_ARGUMENT;
+		chips[i].assign(waves[i], waves[i] + sizes[i]);
+	}
+	emu88Lib::Rom rom(std::vector<uint8_t>(control, control + controlSize), "embedded");
+	emu88Lib::WaveRom wave(chips);
+	if (!rom.isValid() || !rom.modelIsKnown() || rom.model() != emu88Lib::Model::Sc88 || !wave.isValid())
+		return EMU88_RC_INVALID_ARGUMENT;
+	auto im = std::make_shared<emu88Lib::RomLoader::Sc88RomImages>();
+	im->firmware = rom.takeData();
+	im->wave     = wave.takeData();
+	emu88Lib::RomLoader::setInjectedSc88RomImages(std::move(im));
+	return EMU88_RC_OK;
+}
