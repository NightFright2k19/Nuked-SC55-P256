@@ -74,3 +85,26 @@ void configure_bus(Bus& bus, const ChipConfig& cfg) {
 }
 
 }  // namespace h8500
+
+namespace h8500 {
+
+// Nuked SC-55 Poly: see Bus. Zero pages that take no memory until they are touched.
+u8* Bus::alloc_zero_pages(size_t bytes) {
+#ifdef _WIN32
+  return static_cast<u8*>(VirtualAlloc(nullptr, bytes, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE));
+#else
+  void* p = mmap(nullptr, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  return p == MAP_FAILED ? nullptr : static_cast<u8*>(p);
+#endif
+}
+
+void Bus::free_zero_pages(u8* p, size_t bytes) {
+#ifdef _WIN32
+  (void)bytes;
+  VirtualFree(p, 0, MEM_RELEASE);
+#else
+  munmap(p, bytes);
+#endif
+}
+
+}  // namespace h8500
