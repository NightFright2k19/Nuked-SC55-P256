+// Bitwise copy of a state struct whose only non-trivial members are restored by the caller.
+template <class T>
+static void RawCopy(T& dst, const T& src)
+{
+    std::memcpy(static_cast<void*>(&dst), static_cast<const void*>(&src), sizeof(T));
+}
+
+void Emulator::CopyStateFrom(const Emulator& other)
+{
+    // CPU: keep the links to our own components and our sample callback.
+    {
+        mcu_t& d = *m_mcu;
+        submcu_t* sm = d.sm; pcm_t* pcm = d.pcm; mcu_timer_t* timer = d.timer; lcd_t* lcd = d.lcd;
+        void* ud = d.callback_userdata; const auto cb = d.sample_callback;
+        RawCopy(d, *other.m_mcu); // std::atomic<uint32_t> button_pressed: lock-free, copies as a value
+        d.sm = sm; d.pcm = pcm; d.timer = timer; d.lcd = lcd;
+        d.callback_userdata = ud; d.sample_callback = cb;
+    }
+    // Sub-CPU and timers: plain data plus a back link.
+    {
+        mcu_t* m = m_sm->mcu;
+        RawCopy(*m_sm, *other.m_sm);
+        m_sm->mcu = m;
+    }
+    {
+        mcu_t* m = m_timer->mcu;
+        RawCopy(*m_timer, *other.m_timer);
+        m_timer->mcu = m;
+    }
+    // PCM chip: the wave ROM block is reference counted and must not be copied bitwise.
+    {
+        pcm_t& d = *m_pcm;
+        mcu_t* m = d.mcu;
+        std::shared_ptr<uint8_t> keep = std::move(d.waverom_block);
+        RawCopy(d, *other.m_pcm);
+        new (&d.waverom_block) std::shared_ptr<uint8_t>(std::move(keep)); // overwrite the raw bytes
+        d.share_waveroms_from(d);  // re-derive our own wave ROM pointers
+        d.mcu = m;
+    }
+    // LCD: controller registers and memory only (mutex, backend and pixel buffer stay ours).
+    {
+        lcd_t& d = *m_lcd;
+        const lcd_t& s = *other.m_lcd;
+        d.color1 = s.color1; d.color2 = s.color2;
+        d.LCD_DL = s.LCD_DL; d.LCD_N = s.LCD_N; d.LCD_F = s.LCD_F; d.LCD_D = s.LCD_D;
+        d.LCD_C = s.LCD_C; d.LCD_B = s.LCD_B; d.LCD_ID = s.LCD_ID; d.LCD_S = s.LCD_S;
+        d.LCD_DD_RAM = s.LCD_DD_RAM; d.LCD_AC = s.LCD_AC; d.LCD_CG_RAM = s.LCD_CG_RAM;
+        d.LCD_RAM_MODE = s.LCD_RAM_MODE;
+        std::memcpy(d.LCD_Data, s.LCD_Data, sizeof(d.LCD_Data));
+        std::memcpy(d.LCD_CG, s.LCD_CG, sizeof(d.LCD_CG));
+        d.enable = s.enable.load();
+        d.width = s.width; d.height = s.height;
+    }
+}
